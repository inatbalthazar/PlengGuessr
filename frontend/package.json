{
  "name": "songguessr-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-json": "node -e \"const fs=require('fs'); if(fs.existsSync('../songs.json')) fs.copyFileSync('../songs.json','./public/songs.json'); if(fs.existsSync('../playlists.json')) fs.copyFileSync('../playlists.json','./public/playlists.json');\"",
    "prebuild": "npm run copy-json",
    "dev": "npm run copy-json && vite",
    "build": "npm run copy-json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "impeccable": "^3.6.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.11"
  }
}
